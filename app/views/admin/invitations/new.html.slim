= content_for 'content-header' do
  | 招待状の作成

- breadcrumb :new_admin_invitation

.box.box-primary
  = simple_form_for [:admin, @invitation] do |f|
    .box-body
      = f.error_notification
      = f.input :name
      = f.input :role, collect: Invitation.roles.keys.map { |r| [I18n.t("enums.invitation.role.#{r}"), r] }

    .box-footer
      = f.button :submit, class: %w[btn btn-primary]
